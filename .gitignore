# ===== Wilma .gitignore =====

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Testing & coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.ruff_cache/

# --- Secrets & environment ---
.env
.env.local
*.key
*.pem
secrets/
credentials.json

# --- Data (never commit raw or large data files) ---
data/raw/*
data/interim/*
data/processed/*
!data/raw/README.md
!data/interim/README.md
!data/processed/README.md

# --- Models (never commit large model weights) ---
models/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt

# --- Logs & experiments ---
logs/
wandb/
mlruns/
*.log

# --- OS junk ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Temporary files ---
*.tmp
*.bak
~*

# --- Evaluation results & metrics ---
results/
